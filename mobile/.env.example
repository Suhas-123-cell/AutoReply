# Copy to .env (and/or .env.development / .env.staging / .env.production,
# swapped in per build via react-native-config) — real values are gitignored.
#
# Reference values previously held in eas.json's build profiles:
#   development: http://192.168.1.100:3000
#   preview:     https://staging.openreply.example.com
#   production:  https://app.openreply.example.com
API_BASE_URL=http://localhost:3000

# Google Sign-In (native SDK config — see
# https://react-native-google-signin.github.io/docs/setup). GOOGLE_WEB_CLIENT_ID
# is the "webClientId" GoogleSignin.configure() needs to request an ID token;
# it must match the backend's GOOGLE_WEB_CLIENT_ID in the web app's .env.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
